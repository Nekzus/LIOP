{
  "name": "liop",
  "version": "1.4.0-alpha.0",
  "private": true,
  "description": "Logic-Injection-on-Origin Protocol (LIOP) - Official High-Performance WebAssembly Logic-on-Origin Execution Sandbox",
  "author": "Nekzus Solutions",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://nekzus-32.mintlify.app/",
  "keywords": [
    "liop",
    "mcp",
    "model-context-protocol",
    "logic-on-origin",
    "logic-injection",
    "webassembly",
    "wasi",
    "ai-agents",
    "agentic-ai",
    "zero-trust",
    "pqc",
    "grpc",
    "libp2p"
  ],
  "scripts": {
    "build": "pnpm --filter @nekzus/liop build",
    "sanitize-changelog": "node scripts/sanitize-changelog.js",
    "test": "pnpm --filter @nekzus/liop test",
    "lint": "pnpm --filter @nekzus/liop lint",
    "format": "pnpm --filter @nekzus/liop format",
    "check": "pnpm --filter @nekzus/liop check",
    "license:check": "pnpm --filter @nekzus/liop exec tsx ../../scripts/check-licenses.ts",
    "diagrams:check": "pnpm --filter @nekzus/liop exec tsx ../../scripts/check-diagrams.ts",
    "semantic-release": "semantic-release -e ./release.sdk.config.js",
    "commit": "cz",
    "sync-metadata": "pnpm --filter @nekzus/liop exec tsx scripts/sync-metadata.ts",
    "generate:llms": "pnpm --filter @nekzus/liop exec tsx ../../scripts/generate-llms-full.ts",
    "test:crossnet": "pnpm --filter @nekzus/liop test:crossnet",
    "test:crossnet:burn": "pnpm --filter @nekzus/liop test:crossnet:burn",
    "demo:build": "pnpm --filter @nekzus/liop demo:build",
    "demo:start": "pnpm --filter @nekzus/liop demo:start",
    "demo:start:rebuild": "pnpm --filter @nekzus/liop demo:start:rebuild",
    "demo:stop": "pnpm --filter @nekzus/liop demo:stop",
    "demo:clean": "pnpm --filter @nekzus/liop demo:clean",
    "demo:claude": "pnpm --filter @nekzus/liop demo:claude",
    "demo:inspector": "pnpm --filter @nekzus/liop demo:inspector",
    "demo:playground": "pnpm --filter @nekzus/liop demo:playground",
    "demo:playground:rebuild": "pnpm --filter @nekzus/liop demo:playground:rebuild",
    "demo:client-sdk": "pnpm --filter @nekzus/liop demo:client-sdk",
    "demo:playground:build": "pnpm --filter @nekzus/liop demo:playground-web-build",
    "audit:prod:start": "pnpm --filter @nekzus/liop audit:prod:start",
    "audit:prod:run": "pnpm --filter @nekzus/liop audit:prod:run",
    "audit:prod:runner": "pnpm --filter @nekzus/liop audit:prod:runner",
    "audit:prod:clean": "pnpm --filter @nekzus/liop audit:prod:clean",
    "socket:scan": "socket scan create --report .",
    "socket:score": "socket package score npm @nekzus/liop --markdown",
    "socket:fix": "socket fix",
    "studio": "pnpm --filter @nekzus/liop-studio start",
    "studio:scan": "pnpm --filter @nekzus/liop-studio scan",
    "studio:build": "pnpm --filter @nekzus/liop-studio build:all",
    "studio:test": "pnpm --filter @nekzus/liop-studio test"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release-extras/verified-git-commit": "1.0.11",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.4.0",
    "commitizen": "4.3.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "cz-conventional-changelog": "3.3.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
