{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"root": false,
	"extends": ["../../biome.json"],
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.mts",
			"src/**/*.cts",
			"scripts/**/*.ts",
			"examples/**/*.ts",
			"test/**/*.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
