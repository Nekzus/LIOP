# syntax=docker/dockerfile:1.7

# ==============================================================================
# LIOP Production Readiness Audit — Dockerfile (Local Tarball Parity)
# Installs the local packed @nekzus/liop tarball generated via `pnpm pack`
# to evaluate the exact distribution bundle that will be promoted to npmjs.
# Simulates WAN environments with Traffic Control (tc/netem) and kernel network shaping.
# ==============================================================================

FROM node:22-slim AS builder
LABEL org.nekzus.liop.audit="local-tarball-build"
WORKDIR /app

# Initialize module and install auxiliary audit dependencies
RUN npm init -y \
    && npm pkg set type="module" \
    && npm install --save --no-audit --no-fund --legacy-peer-deps \
       @nekzus/liop-studio@alpha \
       @libp2p/pnet@3.0.29 \
       zod@4.6.5 \
       hono@4.13.8 \
       @hono/node-server@2.1.1 \
       vitest@4.1.11

# Copy and install local packed tarball representing the current branch
COPY nekzus-liop-*.tgz /tmp/nekzus-liop.tgz
RUN npm install --save --no-audit --no-fund --legacy-peer-deps /tmp/nekzus-liop.tgz

# Copy production audit assets
COPY entrypoints/ ./entrypoints/
COPY utils/ ./utils/
COPY hft/ ./hft/
COPY network-profiles/ ./network-profiles/
COPY tests/ ./tests/

# Runtime stage: lean image with iproute2 for tc/netem and curl for healthchecks
FROM node:22-slim AS runtime
LABEL org.nekzus.liop.audit="local-tarball-build"
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends iproute2 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install tsx and vitest globally for running entrypoints and test runner in container
RUN npm install -g tsx vitest

# Copy application artifacts from builder
COPY --from=builder /app ./

# Ensure local node_modules binaries and packages are prioritized
ENV PATH="/app/node_modules/.bin:$PATH"

# Ensure network scripts have execution permissions
RUN chmod +x /app/network-profiles/*.sh

ENV LIOP_LOG_LEVEL=info
ENV LIOP_GRPC_PORT=50051
ENV NODE_OPTIONS="--max-old-space-size=2048"

EXPOSE 3000 4000 4001 50051

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=5 \
  CMD curl -sf http://localhost:3000/health || exit 1
