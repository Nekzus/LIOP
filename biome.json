{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"sdks/typescript/src/**/*.ts",
			"sdks/typescript/src/**/*.mts",
			"sdks/typescript/src/**/*.cts",
			"sdks/typescript/scripts/**/*.ts",
			"sdks/typescript/examples/**/*.ts",
			"sdks/typescript/tests/**/*.ts"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
