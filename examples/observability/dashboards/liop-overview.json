    {
      "id": 50,
      "type": "stat",
      "title": "Data Sovereignty Ratio",
      "description": "Percentage of origin data that remains within the enclave boundary. Computed from wire saved bytes vs egress bytes.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "clamp_max(clamp_min((sum(liop_wire_saved_bytes_total{instance=~\"$instance\"}) / (sum(liop_wire_saved_bytes_total{instance=~\"$instance\"}) + sum(liop_wire_egress_bytes_total{instance=~\"$instance\"}))) * 100, 0), 100) or vector(100)",
          "legendFormat": "Sovereignty Ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
